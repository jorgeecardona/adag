#!/bin/sh
# Regenerate the SVG graphs in docs/assets/ with adag's own renderer.
# Each script in docs/examples/ named here takes the output path as its first argument.
set -eu
cd "$(dirname "$0")/.."
uv run python docs/examples/visualization.py docs/assets/graph.svg
uv run python docs/examples/graph_states.py docs/assets/graph_states.svg
